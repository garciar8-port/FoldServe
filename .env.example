# FoldServe — environment template
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
#   cp .env.example .env

# --- AWS ---
# Credentials themselves go through `aws configure` (~/.aws/credentials), NOT here.
# These are non-secret settings the code/scripts read.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# --- Hugging Face Hub ---
# Create at https://huggingface.co/settings/tokens (read for pulling ESM-2; write to push checkpoints).
# `huggingface-cli login` reads this if exported, or paste the token when prompted.
HF_TOKEN=

# --- NVIDIA NGC (BioNeMo containers, Phase 4) ---
# Create a free account + API key at https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=
NGC_ORG=

# --- Weights & Biases (optional, run logging) ---
# API key at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=foldserve
